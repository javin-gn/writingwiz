# Copy the variables you need into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables). Do not commit a real .env file.

# Required in production
SECRET_KEY=
DATABASE_URL=postgres://user:password@host:port/dbname
ALLOWED_HOSTS=yourdomain.com

# Optional
DEBUG=False
DATABASE_SSL_REQUIRE=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
EMAIL_HOST_USER=astarcompo@gmail.com
EMAIL_HOST_PASSWORD=

# Google sign-in (create an OAuth client at console.cloud.google.com,
# type "Web application"; see README/chat for the exact redirect URI to add)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
